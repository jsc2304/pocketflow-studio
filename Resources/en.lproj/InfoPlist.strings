/* Permission text displayed by macOS. */
"NSAppleEventsUsageDescription" = "PocketFlow Studio pauses Music and Spotify while you dictate, and asks Terminal and iTerm2 which tab is in front so Send to Claude presses Return only where Claude Code runs. Each is used only when you turn it on in Settings.";
"NSAudioCaptureUsageDescription" = "PocketFlow Studio records the other side of a meeting when you start meeting notes, and mutes other apps while you dictate when you turn on Mute other apps while dictating. Audio is processed on this Mac, sent to the API connection you select, or sent to ChatGPT when you select Codex subscription transcription. Temporary recordings are deleted afterwards.";
"NSCalendarsFullAccessUsageDescription" = "When you connect Calendar, PocketFlow Studio shows your upcoming meetings and reads the event under way as you start meeting notes, to name the note and list who was invited. It reads the calendars already on this Mac and never changes them.";
"NSMicrophoneUsageDescription" = "PocketFlow Studio records your microphone when you start dictation. Audio is processed on this Mac, sent to the API connection you select, or sent to ChatGPT when you select Codex subscription transcription. Temporary recordings are deleted afterwards.";
"NSSpeechRecognitionUsageDescription" = "PocketFlow Studio uses Apple's on-device speech recognition only when you choose the Apple model. Cloud recognition is never enabled.";
